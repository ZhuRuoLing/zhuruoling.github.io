---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection, render} from 'astro:content';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((post) => ({
        params: {slug: post.id},
        props: {post},
    }));
}

import {siteName} from '../../data/profile';
import SiteHeader from '../../components/SiteHeader.astro';

const {post} = Astro.props;
const {Content} = await render(post);
---

<BaseLayout title={`${post.data.title} · ${siteName}`} description={post.data.description}>
    <main class="home-shell">
        <SiteHeader article/>
        <div class="panel article-content" data-route-content>
            <p style="font-size: 0.85em; color: var(--text-secondary); margin: 0">
                <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
            </p>

            <h1>{post.data.title}</h1>

            {
                post.data.tags.length > 0 && (
                            <p style="font-size: 0.85em; color: var(--text-secondary)">
                                {post.data.tags.map((tag) => `#${tag}`).join('  ')}
                            </p>
                )
            }

            <article>
                <Content/>
            </article>
        </div>
    </main>
</BaseLayout>
