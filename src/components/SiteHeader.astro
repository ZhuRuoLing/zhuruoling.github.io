---
import { bios, siteName, socialLinks } from '../data/profile';
import '../styles/header.css';

interface Props { article?: boolean }
const { article = false } = Astro.props;
const Name = article ? 'p' : 'h1';
---

<header class="panel home-topbar reveal-card" data-topbar data-bios={JSON.stringify(bios)} data-reveal>
  <div class:list={['topbar-normal', { 'article-topbar': article }]} data-topbar-normal>
    <div class="topbar-identity">
      {article && (
        <a class="profile-link home-back" href="/" aria-label="返回首页" data-header-part="back">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7M7 12h14" /></svg>
        </a>
      )}
      <div class="profile-identity" data-header-part="identity">
        <Name class="profile-name">{siteName}</Name>
        <p class="profile-bio">
          <span class="home-sr-only" data-bio-readable>{bios[0]}</span>
          {/* 视觉占位层（漢字幽灵）：纯装饰，对抽取器隐藏。
              每个 bio 各一个 span，共用 grid-area 1/1，由最高的那个决定行高。 */}
          {bios.map((bio) => (
            <span class="profile-bio-space" aria-hidden="true" data-header-decoration>{'漢'.repeat(Array.from(bio).length)}</span>
          ))}
          <span class="profile-bio-visual" data-bio-visual aria-hidden="true" data-header-decoration>{bios[0]}</span>
        </p>
      </div>
    </div>
    {!article && (
      <form class="home-search desktop-search" role="search" aria-label="站内搜索" data-header-part="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
        <label class="home-sr-only" for="home-search-desktop">搜索文章，支持 #标签</label>
        <input id="home-search-desktop" data-search-input type="search" placeholder="搜索文章 / #标签" autocomplete="off" aria-controls="home-posts" />
      </form>
    )}
    <nav class="profile-links desktop-contacts" aria-label="联系方式" data-header-part="desktop-contacts">
      {socialLinks.map((link) => (
        <a class="profile-link" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
          <img src={link.icon} width="24" height="24" alt="" />
        </a>
      ))}
    </nav>
    <div class="compact-actions">
      {!article && (
        <button class="profile-link" type="button" data-open-overlay="search" aria-label="打开搜索" aria-controls="site-overlay" aria-expanded="false" data-header-part="compact-search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
        </button>
      )}
      <button class="profile-link" type="button" data-open-overlay="contacts" aria-label="打开联系方式" aria-controls="site-overlay" aria-expanded="false" data-header-part="compact-contacts">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v12H9l-5 4V4Z" /><path d="M8 8h8M8 12h5" /></svg>
      </button>
    </div>
  </div>
  <div id="site-overlay" class="topbar-overlay" data-overlay inert aria-hidden="true" hidden data-header-decoration>
    <div class="overlay-content">
      <button class="profile-link overlay-back" type="button" data-close-overlay aria-label="返回顶栏">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7M7 12h14" /></svg>
      </button>
      {!article && (
        <form class="home-search overlay-search" data-overlay-view="search" role="search" aria-label="移动端站内搜索" hidden inert>
          <label class="home-sr-only" for="home-search-mobile">搜索文章，支持 #标签</label>
          <input id="home-search-mobile" data-search-input type="search" placeholder="搜索 / #标签" autocomplete="off" aria-controls="home-posts" />
        </form>
      )}
      <nav class="profile-links overlay-contacts" data-overlay-view="contacts" aria-label="联系方式" hidden inert>
        {socialLinks.map((link) => (
          <a class="profile-link" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
            <img src={link.icon} width="24" height="24" alt="" />
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  import '../scripts/header';
</script>
